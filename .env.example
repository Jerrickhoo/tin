# Copy to .env and fill in from the Supabase dashboard (Phase 2).
# VITE_-prefixed vars are PUBLIC — baked into the JS bundle. The anon key is
# safe here ONLY because RLS is on every table. The service_role key must
# NEVER appear in this file, the repo, or Netlify env vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
